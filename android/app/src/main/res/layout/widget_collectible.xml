<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews 只允许基础控件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_desc" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="L U M O R A    /    C O L L E C T I O N"
        android:textColor="#AF7449"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#183B38"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.2"
        android:textColor="#7B8477"
        android:textSize="10sp"
        android:text="LUMORA / 今日一藏" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="end|center_vertical"
        android:textColor="#183B38"
        android:textSize="12sp"
        android:contentDescription="浏览下一件藏品" />
</LinearLayout>
